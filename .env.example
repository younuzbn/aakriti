PORT=3020
NODE_ENV=production

# MongoDB (new, Aakriti-only database)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aakriti?retryWrites=true&w=majority

# Signing key for staff portal login tokens (AAKRITI_JWT_SECRET falls back to JWT_SECRET).
# Use the same value as the old server to keep existing staff sessions valid; otherwise anyone logs in again.
AAKRITI_JWT_SECRET=change-me-to-a-long-random-string

# Master portal admin (login + creating accounts from the login page)
AAKRITI_ADMIN_USERNAME=admin
AAKRITI_ADMIN_PASSWORD=change-me

# Optional: extra allowed CORS origins, comma separated
CORS_ORIGIN=
